# Postgres
DATABASE_URL=postgres://allarop:allarop@localhost:5432/allarop

# Var nedladdade bilder lagras (aggressiv spegling)
IMAGE_DIR=./data/images

# Hur ofta full katalog-refresh sker (ms). Default 10 min.
FULL_REFRESH_MS=600000
# Tät polling för objekt som snart avslutas (ms). Default 45 s.
HOT_POLL_MS=45000
# Ett objekt anses "hett" om det avslutas inom så här många ms. Default 60 min.
HOT_WINDOW_MS=3600000

# Ditt eget budgivaralias på Tovek — markeras med "DU LEDER" i sök/API.
MY_BIDDER=
